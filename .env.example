# Copy this file to server/.env and fill in real values before deploying.
# For local development you can leave DATABASE_URL empty - the app will run on
# PGlite (embedded PostgreSQL) with no database install required.

# --- Database ---
# Leave blank locally. On Render / Railway / DigitalOcean paste the connection
# string their dashboard gives you, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/courier
DATABASE_URL=

# --- Security ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# --- Server ---
PORT=4000
NODE_ENV=development

# Where the React app is served from (used for CORS in development)
CLIENT_ORIGIN=http://localhost:5173

# --- First admin account (created by `npm run db:setup`) ---
ADMIN_EMAIL=admin@courier.local
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Owner
