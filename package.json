{
  "name": "courier-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Courier service management app - jobs, mileage, customers, invoicing",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace server",
    "dev:client": "npm run dev --workspace client",
    "db:setup": "npm run db:setup --workspace server",
    "db:reset": "npm run db:reset --workspace server",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
